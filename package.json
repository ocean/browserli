{
  "name": "browserli",
  "version": "0.1.0",
  "description": "🥦 Browser automation for Google Maps data importing via Cloudflare Workers",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:full": "npm run playwright:server & npm run dev",
    "playwright:server": "node playwright-server.js",
    "deploy": "wrangler deploy",
    "build": "wrangler build",
    "lint": "oxlint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "playwright",
    "browser-automation",
    "google-maps"
  ],
  "dependencies": {
    "@cloudflare/playwright": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.70.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.110.0"
  }
}
